# My_Fix Supabase Project Environment Variables Example
# Duplicate this file to '.env' and fill in your actual credentials

# Supabase API URL (Reference: tarvtukfkytouhyuiamb)
SUPABASE_URL=https://tarvtukfkytouhyuiamb.supabase.co

# Next.js public env (copy to .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://tarvtukfkytouhyuiamb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_jwt_key_here

# Supabase Legacy Anonymous API Key (JWT-based)
SUPABASE_ANON_KEY=your_legacy_anon_jwt_key_here

# Supabase Modern Publishable API Key (sb_publishable_...)
# Recommended for frontend/client integrations
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Supabase Service Role Key (Keep secret! Do not share!)
# Used for backend scripts, database seeding, or admin edge functions
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key_here

# Database Direct Connection Password (e.g. Ohunene@1234)
# Note: For IPv6/network limitations, connect using Supabase MCP instead of direct connection
DATABASE_PASSWORD=your_database_password_here

# --- Seed API admin guard --------------------------------------------
# The /api/seed route mass-inserts artisans using the service-role key.
# It refuses all requests unless a matching admin token is provided.
#   ADMIN_SEED_TOKEN            -> server-only, validated against the request header
#   NEXT_PUBLIC_ADMIN_SEED_TOKEN -> read by the browser and sent as x-admin-token
# Pick any random string; the two values must match.
ADMIN_SEED_TOKEN=change-me-to-a-long-random-string
NEXT_PUBLIC_ADMIN_SEED_TOKEN=change-me-to-a-long-random-string

# --- Paystack webhook (Edge Function) --------------------------------
# Set these in the Supabase Edge Function environment (not Next.js).
# PAYSTACK_SECRET_KEY is used to HMAC-verify incoming webhook signatures.
PAYSTACK_SECRET_KEY=sk_test_or_live_your_paystack_secret_key

